# =============================================================================
# Variables de Entorno — Despliegue On-Premise de Modelos Velvet
# =============================================================================
# Copiar este archivo como .env y completar los valores antes de ejecutar
# docker compose up.
#
# IMPORTANTE: No subir el archivo .env al repositorio. Está incluido en
# .gitignore por seguridad.
# =============================================================================

# -----------------------------------------------------------------------------
# Autenticación del Reverse Proxy (Caddy)
# -----------------------------------------------------------------------------
# Usuario para autenticación Basic Auth contra la API de Ollama.
OLLAMA_AUTH_USER=admin

# Hash bcrypt de la contraseña para Caddy.
# Para generar el hash, ejecutar:
#
#   caddy hash-password --plaintext <tu_contraseña>
#
# Ejemplo:
#   caddy hash-password --plaintext "mi_contraseña_segura"
#
# El resultado será algo como:
#   $2a$14$Zkx19XLiW6VYouLRR3bKz.....
#
# Copiar el hash completo (incluyendo el prefijo $2a$) aquí:
OLLAMA_AUTH_HASH=

# -----------------------------------------------------------------------------
# Token de Hugging Face
# -----------------------------------------------------------------------------
# Token de acceso de Hugging Face, necesario para descargar modelos privados
# o con acceso restringido (gated models) como los de Almawave.
# Obtener en: https://huggingface.co/settings/tokens
HF_TOKEN=
